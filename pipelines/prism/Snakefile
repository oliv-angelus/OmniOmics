import json
import os

import pandas as pd

configfile: "config/config.yaml"

# Where results/, logs/ and .snakemake/ (including --use-conda's own built
# environments, unless --conda-prefix points them elsewhere) land for THIS
# invocation. Optional and non-breaking: the app itself never hits this --
# it always launches Snakemake with its own `--directory=<output_dir>` CLI
# flag (backend/main.py), and a CLI --directory always wins over this
# directive. This only takes effect for a direct/manual `snakemake` call
# with no --directory of its own (e.g. PRISM-HPC on a cluster), giving a
# config.yaml-driven way to point separate runs at separate output folders
# instead of everything colliding into a single relative "results/" (real
# gap found 2026-09-11, the same directive MAGMA's own Snakefile already
# carries -- PRISM never had it, and it would have silently written the
# coi-12s real-data run's results/ into the shared PRISM-root/pipeline/
# checkout instead of the project's own output_root).
workdir: config.get("output_root", ".")

# amplicon_preset_id: select a preset by id (pipeline.yaml's own
# amplicon_presets list -- gene + reference_db + primers + length window,
# already bundled consistently together) instead of hand-copying the whole
# block into config.yaml. Real need, not speculative: on a cluster with no
# app UI (config_engine.py's own preset expansion only runs inside the app),
# writing every preset field by hand for each new project was found to be
# genuinely error-prone and slow (2026-09-11, PRISM-HPC/tapajos). Only fires
# when amplicon_preset (the full dict) isn't already provided directly -- an
# explicit amplicon_preset: block always wins, same "manual override beats
# resolved default" convention _gene()/_reference_db()/_cutadapt_primers
# already use elsewhere in this pipeline. pipeline.yaml must be shipped
# alongside the Snakefile for this to work (sync_pipeline_from_omniomics.sh
# does this since the same day).
if not config.get("amplicon_preset") and config.get("amplicon_preset_id"):
    _manifest_path = os.path.join(workflow.basedir, "pipeline.yaml")
    if not os.path.isfile(_manifest_path):
        raise ValueError(
            f"amplicon_preset_id was set but {_manifest_path} doesn't exist -- "
            "pipeline.yaml needs to be shipped alongside the Snakefile for this to work."
        )
    with open(_manifest_path) as _f:
        _manifest = json.load(_f)
    _presets = {p["id"]: p for p in _manifest.get("amplicon_presets", [])}
    _preset_id = config["amplicon_preset_id"]
    if _preset_id not in _presets:
        raise ValueError(
            f"amplicon_preset_id '{_preset_id}' not found in {_manifest_path}'s "
            f"amplicon_presets -- available ids: {sorted(_presets)}"
        )
    config["amplicon_preset"] = _presets[_preset_id]

samples = pd.read_table(config["samples"]).set_index("sample", drop=False).fillna("")
SAMPLES = samples.index.tolist()

# PRISM was long-read-only by deliberate scope decision through 2026-09-11;
# short-read (Illumina) paired-amplicon support (COI/12S fish metabarcoding,
# but usable for any short-amplicon marker) was added that day -- see
# notes/PRISM.md's "Short-read (Illumina) path added" section. Every sample
# is now either "short" or "long", same two of MAGMA/SIGMA/DOGMA's three
# read_type values (no "hybrid": a single amplicon run is one platform, there
# is no real protocol that merges short + long reads for the same amplicon).
# Kept as a real check rather than assumed, since a stray bad read_type value
# would otherwise fail silently deep in the DAG instead of at the point
# samples are loaded.
_bad = [s for s in SAMPLES if samples.loc[s, "read_type"] not in ("short", "long")]
if _bad:
    raise ValueError(f"PRISM only accepts read_type short or long; bad samples found: {_bad}")

LONG_SAMPLES = [s for s in SAMPLES if samples.loc[s, "read_type"] == "long"]
SHORT_SAMPLES = [s for s in SAMPLES if samples.loc[s, "read_type"] == "short"]

# Long-read platform (Nanopore vs PacBio HiFi) is one run-wide choice (same
# mechanism DOGMA's long_read_platform already uses for Flye/SPAdes flags --
# see config_engine.py) -- it picks which denoising engine's rule actually
# runs (dada2_pacbio vs emu_ont); the other one's rule no-ops (touches empty
# outputs), the same if/else-touch idiom fastp/filtlong already use for their
# own short/long branching.
#
# "none" (not the default-to-"ont" this used to be) when there are zero
# long-read samples -- real bug, caught by a real run (2026-09-11,
# coi-12s/coi, a genuinely short-read-only project with no long_read_platform
# key in its config at all): the old unconditional default silently made
# PLATFORM=="ont" true, which is a real value every emu_build_db/emu_tree
# shell guard checks -- so emu_build_db ran FOR REAL (not its touch-empty
# branch) and built a complete, genuinely unused Emu index from MIDORI2's
# full 1.8M-sequence COI database, wasted real HPC time/disk for a run that
# will only ever use dada2_illumina. "none" never matches "ont" or
# "pacbio_hifi", so every PLATFORM-gated rule correctly no-ops instead.
PLATFORM = config.get("long_read_platform", {}).get("id", "ont") if LONG_SAMPLES else "none"

wildcard_constraints:
    sample="[^/]+"

rule all:
    input:
        expand("results/01_QC/{sample}/nanoplot_raw/NanoStats.txt", sample=LONG_SAMPLES),
        expand("results/01_QC/{sample}/nanoplot_clean/NanoStats.txt", sample=LONG_SAMPLES),
        expand("results/02_PRIMER_TRIM/{sample}/{sample}_trimmed.fastq.gz", sample=LONG_SAMPLES),
        expand("results/03_CHIMERA/{sample}/{sample}_nonchimeric.fastq.gz", sample=LONG_SAMPLES),
        # Short-read (Illumina) path -- see 01_qc.smk/02_primer_trim.smk. No
        # equivalent of results/03_CHIMERA here: chimera removal happens
        # inside dada2_illumina.R itself (DADA2's own removeBimeraDenovo),
        # not a separate VSEARCH step (see that rule's own comment for why).
        expand("results/01_QC/{sample}/{sample}_R1_clean.fastq.gz", sample=SHORT_SAMPLES),
        expand("results/02_PRIMER_TRIM/{sample}/{sample}_R1_trimmed.fastq.gz", sample=SHORT_SAMPLES),
        "results/05_ABUNDANCE_TABLE/prism_abundance_table.tsv",
        # ONT/Emu path's closed-reference phylogenetic tree (see
        # 04_denoise_classify.smk's emu_tree rule) -- listed unconditionally
        # like every other optional-per-platform target; the rule itself
        # no-ops on the PacBio branch (its own tree is built inline by
        # dada2_pacbio.R instead, see that rule's own comment).
        "results/04_DENOISE/emu/tree_done.flag",
        # Functional inference (PICRUSt2) -- optional (disabling it
        # --omit-from's it away like every other optional PRISM tool), only
        # ever real for the PacBio+16S path (see 05_functional_inference.smk
        # for why), listed unconditionally here the same way every other
        # optional tool's target is.
        "results/06_FUNCTIONAL/KO_metagenome_out/pred_metagenome_unstrat.tsv.gz",
        "results/06_FUNCTIONAL/EC_metagenome_out/pred_metagenome_unstrat.tsv.gz",
        "results/06_FUNCTIONAL/pathways_out/path_abun_unstrat.tsv.gz",

include: "workflow/rules/01_qc.smk"
include: "workflow/rules/02_primer_trim.smk"
include: "workflow/rules/03_chimera.smk"
include: "workflow/rules/04_denoise_classify.smk"
include: "workflow/rules/05_functional_inference.smk"
