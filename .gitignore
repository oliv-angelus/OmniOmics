*.pyc

# Stray default graphics device output, written whenever an R script
# opens a plot device without a filename while cwd is the repo root.
Rplots.pdf
TRANSFER_NOTES.txt
free.csv

# Currículo com dados pessoais -- fica local, nunca no repositório
Currículo Lattes.pdf
*.lattes.pdf

# Pacotes gerados pelo build -- vão para a Release, não para o repositório
dist/

# Working notes -- kept locally. A summarised, English dev-notes will
# replace them in the repository.
notes/

# Snapshots of the application's own settings file, taken while developing
backups/

# Local editor/tool config -- machine-specific, not project source
.vscode/
.claude/
